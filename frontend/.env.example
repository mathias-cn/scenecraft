# Compose usa o .env na raiz do repo. Este arquivo vale para `npm run dev` local.
# Copie as mesmas chaves de autenticação do .env.example da raiz.

NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Autenticação (Better Auth + Google OAuth, um único dono) ---
# O login só aceita o email em OWNER_EMAIL.
# Redirect URI no Google Cloud Console:
#   https://scenecraft.mazting.studio/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google  (dev)
BETTER_AUTH_SECRET=generate-a-strong-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
OWNER_EMAIL=you@example.com
