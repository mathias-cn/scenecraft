# --- Database ---
DATABASE_URL=postgresql://scenecraft:scenecraft@postgres:5432/scenecraft

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Higgsfield (geração de vídeo) ---
HIGGSFIELD_API_KEY=your_higgsfield_api_key_here

# --- ElevenLabs (voz / TTS) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- Anthropic (roteiro / LLM) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- YouTube Data API (OAuth) ---
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# --- Object storage: AWS S3 ou Cloudflare R2 ---
S3_BUCKET=scenecraft-media
S3_REGION=auto
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key_id_here
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_access_key_here
# Deixe vazio para AWS S3. Para R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
R2_ACCOUNT_ID=your_cloudflare_r2_account_id_here
R2_PUBLIC_BASE_URL=https://media.example.com

# --- Apps ---
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
