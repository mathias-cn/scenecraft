# --- Supabase Postgres ---
# Settings > Database: copie a URI direta (porta 5432) e a do pooler (porta 6543).
# sslmode=require é obrigatório. A senha com caracteres especiais deve ir URL-encoded.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL_MIGRATIONS=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_LOGLEVEL=info
# Concorrência por fila (um worker Celery por tipo de job)
CELERY_CONCURRENCY_TRANSCRIBE=2
CELERY_CONCURRENCY_SCENE_PLANNING=2
CELERY_CONCURRENCY_MEDIA_GEN=1
CELERY_CONCURRENCY_AUDIO_GEN=2
CELERY_CONCURRENCY_RENDER=1
CELERY_CONCURRENCY_THUMBNAIL=2
CELERY_CONCURRENCY_DESCRIPTION=2
# Retry Celery: max_retries=2 => 3 tentativas no total (backoff 2^n segundos)
CELERY_TASK_MAX_RETRIES=2
CELERY_RETRY_BACKOFF_BASE=2
# Semáforo Redis: chamadas simultâneas por provider externo
PROVIDER_CONCURRENCY_HIGGSFIELD=2
PROVIDER_CONCURRENCY_ELEVENLABS=3
PROVIDER_CONCURRENCY_OPENAI=4
PROVIDER_CONCURRENCY_R2=4
# ffmpeg: clipes de cena em paralelo no render (Ken Burns / still). CPU-bound; 2–4 é o intervalo útil.
RENDER_CLIP_CONCURRENCY=2
# Rate limit por fila (requisições / RATE_LIMIT_WINDOW_SECONDS)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRANSCRIBE=20
RATE_LIMIT_SCENE_PLANNING=20
RATE_LIMIT_MEDIA_GEN=4
RATE_LIMIT_AUDIO_GEN=10
RATE_LIMIT_RENDER=2
RATE_LIMIT_THUMBNAIL=10
RATE_LIMIT_DESCRIPTION=20

# --- Higgsfield (geração de vídeo) ---
HIGGSFIELD_API_KEY=your_higgsfield_api_key_here
# Opcional: se a chave não estiver no formato id:secret, informe o secret à parte.
HIGGSFIELD_API_SECRET=

# --- ElevenLabs (voz / TTS) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- OpenAI (Whisper + LLM: cenas, tradução, descrição, títulos) ---
OPENAI_API_KEY=your_openai_api_key_here
# Modelo de texto para sugestão de títulos (o mais barato da conta: gpt-5-nano)
OPENAI_TITLE_MODEL=gpt-5-nano

# --- Object storage: AWS S3 ou Cloudflare R2 ---
S3_BUCKET=scenecraft-media
S3_REGION=auto
S3_ACCESS_KEY_ID=your_s3_or_r2_access_key_id_here
S3_SECRET_ACCESS_KEY=your_s3_or_r2_secret_access_key_here
# Deixe vazio para AWS S3. Para R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your_cloudflare_r2_account_id_here
# Domínio customizado ligado ao bucket. A URL pública é {base}/{object_key}, sem o nome do bucket.
R2_PUBLIC_BASE_URL=https://cdn.mazting.studio
CLOUDFLARE_API_TOKEN=

# --- Apps ---
# Dev (docker-compose.yml): localhost. Produção (Caddy + docker-compose.prod.yml):
# CORS_ORIGINS=https://scenecraft.mazting.studio
# NEXT_PUBLIC_API_URL=https://api.mazting.studio
# (NEXT_PUBLIC_API_URL é baked no build da imagem — reconstrua o frontend se mudar).
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Better Auth (frontend Next.js, Google OAuth, um único dono) ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-strong-random-secret-at-least-32-chars
# Produção (Caddy + Cloudflare). Em dev local use http://localhost:3000
BETTER_AUTH_URL=https://scenecraft.mazting.studio
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
OWNER_EMAIL=you@example.com
# Redirect URI no Google Cloud Console:
#   https://scenecraft.mazting.studio/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google  (dev)
